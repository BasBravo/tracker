{
  "name": "functions",
  "description": "Firebase Functions - Backend del proyecto Tracker",
  "scripts": {
    "build": "pnpm exec tsc",
    "build:watch": "pnpm exec tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=1 jest --runInBand --testPathPattern=integration.test",
    "test:canyon": "pnpm run build && node lib/scripts/testCanyon.js",
    "run-jobs": "pnpm run build && node -r dotenv/config lib/scripts/runScheduledJobs.js",
    "run-jobs:force": "pnpm run build && FORCE_CHECK=1 node -r dotenv/config lib/scripts/runScheduledJobs.js",
    "list-trackings": "pnpm run build && node -r dotenv/config lib/scripts/listTrackings.js",
    "lint": "eslint src --ext .ts",
    "deploy": "firebase deploy --only functions",
    "deploy:scheduler": "firebase deploy --only functions",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "@google-cloud/vertexai": "^1.10.0",
    "google-auth-library": "^9.0.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "node-html-parser": "^6.1.0",
    "nodemailer": "^6.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv": "^16.4.0",
    "domhandler": "^5.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
