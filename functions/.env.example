# SMTP (envío de alertas por email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente de las alertas (FROM_EMAIL, SMTP_FROM o MAIL_FROM)
FROM_EMAIL=tracker@example.com

# Firebase / proyecto (opcional; el emulador usa GCLOUD_PROJECT)
# GCLOUD_PROJECT=tu-project-id
