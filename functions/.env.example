# SMTP (envío de alertas por email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente de las alertas (FROM_EMAIL, SMTP_FROM o MAIL_FROM)
FROM_EMAIL=tracker@example.com

# Firebase: proyecto a usar en scripts locales (run-jobs, test:canyon, list-trackings).
# Debe coincidir con .firebaserc (p. ej. zero-18081). Si no se define, se usa el de la cuenta de servicio.
# NO uses PROJECT_ID aquí: Firebase lo reserva y el deploy fallará. Usa solo PROJECT_ID.
# PROJECT_ID=zero-18081

# IA – criterios desde instrucción (creación de tracking) y extracción de productos (fallback)
# Opción 1: Vertex AI (GCP, mismo proyecto). Requiere Vertex AI API habilitada y facturación.
# VERTEX_AI_LOCATION=europe-west1
# Opción 2: Gemini API (tier gratuito). API key desde https://aistudio.google.com
# GEMINI_API_KEY=your-api-key
# Desactivar extracción de criterios por IA: GEMINI_CRITERIA_EXTRACTION_ENABLED=false
# Desactivar fallback IA para productos: GEMINI_EXTRACTION_ENABLED=false
